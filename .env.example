# Copy to .env.local and fill in real values. Never commit .env.local.
# In Vercel these are set by the Neon integration for Production and Preview.

# Pooled connection used by the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct connection used by migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
