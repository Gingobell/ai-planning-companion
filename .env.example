# Copy to .env.local and fill in real values. Never commit .env.local.
# In Vercel the DATABASE_ values come from the Neon integration; the NEON_AUTH_ values are added by hand (Production and Preview).

# Pooled connection used by the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct connection used by migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth URL, copied from the Neon Console (Auth settings).
NEON_AUTH_BASE_URL=https://your-auth-endpoint.example/neondb/auth
# Secret for signing session cookies, at least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-32-or-more-random-characters
